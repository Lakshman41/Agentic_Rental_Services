ENV/

# --- Secrets & Environment Variables ---
# IMPORTANT: Ensure .env (actual secrets) is listed and NEVER committed.
.env
*.env.*.local
*.env.local
# !.env.example # Example file IS committed
# !.env.ci      # Example CI environment file IS committed if safe

# Cloud provider credentials & config files (examples, add specific ones you use)
# .aws/
# .boto
# .gcloud/
# Add other cloud CLI configurations

# General private keys (ca.pem is handled separately based on policy)
# *.pem # If you have other private .pem files
*.key 
ca.pem
credentials.json # Common name for service account keys
secrets.json     # Another common name
# Specific sensitive files
client_secret*.json # Common for OAuth client secrets
oauth_secrets.json

# Local database files (if not using Dockerized DB for dev exclusively)
*.sqlite3
*.db

# --- IDE / Editor Specific ---
.vscode/
!.vscode/settings.json # Optional: commit workspace settings if desired by team
!.vscode/launch.json   # Optional: commit launch configurations if desired
!.vscode/extensions.json # Optional: commit recommended extensions if desired

.idea/
# .idea/workspace.xml # Generally ignored, contains local user history
# .idea/shelf/        # IntelliJ shelf changes

*.project
*.pydevproject
*.sublime-workspace
*.sublime-project

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Vim / Emacs
*~
*.swp
*.swo
.#*


# Application Settings
APP_NAME="Agentic Rental Platform"
ENVIRONMENT="development" # development, staging, production
DEBUG=True
SECRET_KEY="your_super_secret_and_long_random_key_here" # IMPORTANT: Generate a real random key for actual .env

# PostgreSQL Database
POSTGRES_USER="your_db_user"
POSTGRES_PASSWORD="your_db_password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="agentic_rental_db"
# DATABASE_URL will be constructed from these, or you can set it directly
# e.g., DATABASE_URL="postgresql+asyncpg://user:password@host:port/dbname"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_PASSWORD="" # Set if your Redis is password protected

# Celery Broker (using Redis)
CELERY_BROKER_URL="redis://localhost:6379/1" # Using a different Redis DB for Celery
CELERY_RESULT_BACKEND="redis://localhost:6379/2" # Using a different Redis DB for Celery results

# AI Services API Keys (Leave blank or use placeholders if not immediately available)
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
# HUGGINGFACE_API_TOKEN="" # If using private models or specific services

# Real-time Features (WebSockets - these are typically part of the app server config)
# No specific .env vars needed for basic WebSocket setup with Uvicorn/FastAPI initially

# GDPR/Compliance - placeholders for now
# DATA_RETENTION_PERIOD_DAYS="365"

# Add other environment-specific settings as needed